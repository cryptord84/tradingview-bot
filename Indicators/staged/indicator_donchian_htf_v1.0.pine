//@version=6
// Donchian HTF v1.0 — Alert Indicator
// Created 2026-06-09: HTF-filtered Donchian variant for the nightly HTF run's
// Tier-A passer SOL/1D (PF 4.43, IS 4.46 / OOS 4.24, 30 trades, DD 4.6%).
// The plain (unfiltered) Donchian/SOL/1D FAILS walk-forward (OOS 0.60) — the
// HTF gate is load-bearing. Do NOT point this script's alerts at tokens whose
// validation came from the unfiltered run, or vice versa.
//
// Identical to Donchian Breakout v1.1 (incl. restored mid-channel CLOSE) plus:
//   - Entries gated on the 4× -timeframe EMA(20) slope, evaluated on the last
//     CLOSED HTF bar ([1] vs [2] via request.security, lookahead_off — no
//     repaint). Mirrors backtesting/strategies.py _apply_higher_tf_filter
//     (htf_multiplier=4, ema_length=20, shift(1) = last closed bar's slope).
//   - Exits are NOT gated (matches backtest: filter applies to entries only).
//
// Signal logic:
//   BUY:   close breaks above prior-bar channel high + volume surge
//          AND 4×TF EMA(20) rising on the last closed HTF bar
//   CLOSE: close crosses under mid-channel — edge-triggered

indicator("Donchian HTF v1.0 — Alerts", overlay=true, max_bars_back=500)

// ── Inputs ────────────────────────────────────────────────────────────────────
var grp_wh   = "Webhook"
var grp_ch   = "Channel"
var grp_vol  = "Volume Filter"
var grp_risk = "Risk"
var grp_disp = "Display"
var grp_htf  = "HTF Filter"

webhook_secret = input.string("CHANGE_ME", "Webhook Secret",        group=grp_wh)
chPeriod       = input.int(20,   "Channel Period",     minval=5,    group=grp_ch)
volLen         = input.int(20,   "Volume MA Length",   minval=5,    group=grp_vol)
volMult        = input.float(1.5, "Min Volume (× MA)", step=0.1,    group=grp_vol)
confidence     = input.int(65,   "Confidence Score",   minval=1, maxval=100, group=grp_risk)
leverage       = input.int(2,    "Suggested Leverage", minval=1, maxval=10,  group=grp_risk)
pos_size       = input.float(15.0, "Position Size %",  minval=1.0, maxval=100.0, step=1.0, group=grp_risk)
realtimeTrig   = input.bool(false, "Real-time Trigger (vs Bar Close)", group=grp_risk)
showCh         = input.bool(true, "Show Channel",      group=grp_disp)
htfEmaLen      = input.int(20,   "HTF EMA Length",     minval=2,    group=grp_htf)

// ── Calculations ──────────────────────────────────────────────────────────────
ch_upper = ta.highest(high, chPeriod)[1]
ch_lower = ta.lowest(low,   chPeriod)[1]
ch_mid   = (ch_upper + ch_lower) / 2

volOk   = volume > ta.sma(volume, volLen) * volMult
atr_val = ta.atr(14)
rsi_val = ta.rsi(close, 14)

// HTF EMA slope gate: 4× the chart timeframe, last CLOSED bar's slope only.
// [1]/[2] offsets + lookahead_off = confirmed bars, no repaint.
htfTf    = timeframe.from_seconds(timeframe.in_seconds(timeframe.period) * 4)
htfEma   = ta.ema(close, htfEmaLen)
htfEma1  = request.security(syminfo.tickerid, htfTf, htfEma[1], lookahead = barmerge.lookahead_off)
htfEma2  = request.security(syminfo.tickerid, htfTf, htfEma[2], lookahead = barmerge.lookahead_off)
htfRising = not na(htfEma1) and not na(htfEma2) and htfEma1 > htfEma2

// ── Signals ───────────────────────────────────────────────────────────────────
long_entry  = ta.crossover(close, ch_upper) and volOk and htfRising
// Edge-triggered exit, matches backtesting/strategies.py (close < mid_prev).
// NOT gated on HTF — backtest filter applies to entries only.
long_exit   = ta.crossunder(close, ch_mid) and not long_entry

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(showCh ? ch_upper : na, "Channel High", color=color.new(color.green, 50), linewidth=1)
plot(showCh ? ch_lower : na, "Channel Low",  color=color.new(color.red, 50),   linewidth=1)
plot(showCh ? ch_mid   : na, "Channel Mid",  color=color.new(color.gray, 60),  linewidth=1)
bgcolor(htfRising ? na : color.new(color.red, 94), title="HTF Filter Blocking")

plotshape(long_entry,  "Long Entry",  shape.triangleup,   location.belowbar, color.green,  size=size.small)
plotshape(long_exit,   "Long Exit",   shape.circle,       location.abovebar, color.yellow, size=size.tiny)


// ── Webhook Alerts ────────────────────────────────────────────────────────────
_sym   = syminfo.ticker
_tf    = timeframe.period
_strat = "Donchian HTF v1.0"
_freq  = realtimeTrig ? alert.freq_once_per_bar : alert.freq_once_per_bar_close

if long_entry
    alert('{"secret":"' + webhook_secret + '"' +
          ',"signal_type":"BUY"' +
          ',"symbol":"' + _sym + '"' +
          ',"entry_price_estimate":' + str.tostring(close) +
          ',"confidence_score":' + str.tostring(confidence) +
          ',"suggested_leverage":' + str.tostring(leverage) +
          ',"suggested_position_size_percent":' + str.tostring(pos_size) +
          ',"rsi":' + str.tostring(math.round(rsi_val, 2)) +
          ',"atr":' + str.tostring(atr_val) +
          ',"timeframe":"' + _tf + '"' +
          ',"strategy":"' + _strat + '"' +
          '}', _freq)

if long_exit
    alert('{"secret":"' + webhook_secret + '"' +
          ',"signal_type":"CLOSE"' +
          ',"symbol":"' + _sym + '"' +
          ',"entry_price_estimate":' + str.tostring(close) +
          ',"confidence_score":50' +
          ',"suggested_leverage":1' +
          ',"suggested_position_size_percent":100' +
          ',"atr":' + str.tostring(atr_val) +
          ',"timeframe":"' + _tf + '"' +
          ',"strategy":"' + _strat + '"' +
          '}', _freq)

// ── Alert Conditions ──────────────────────────────────────────────────────────
alertcondition(long_entry,             "Donchian HTF — BUY",   "Donchian HTF BUY")
alertcondition(long_exit,              "Donchian HTF — CLOSE", "Donchian HTF CLOSE")
